{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNKey",
  "version": "0.1.0",
  "identifier": "com.vnkey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "VNKey - Bảng điều khiển",
        "width": 440,
        "height": 680,
        "minWidth": 380,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "macro",
        "title": "Thiết lập gõ tắt",
        "width": 600,
        "height": 520,
        "minWidth": 480,
        "minHeight": 400,
        "visible": false
      },
      {
        "label": "convert",
        "title": "Công cụ chuyển mã",
        "width": 460,
        "height": 600,
        "minWidth": 400,
        "minHeight": 480,
        "visible": false
      },
      {
        "label": "about",
        "title": "Giới thiệu",
        "width": 380,
        "height": 480,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
